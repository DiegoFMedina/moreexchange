{
  "name": "moreexchange",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @moreexchange/api db:generate",
    "db:migrate": "pnpm --filter @moreexchange/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @moreexchange/api db:migrate:deploy",
    "db:seed": "pnpm --filter @moreexchange/api db:seed",
    "db:studio": "pnpm --filter @moreexchange/api db:studio",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.5",
    "prettier": "^3.3.2",
    "turbo": "^2.0.6",
    "typescript": "^5.5.2"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "pnpm --filter @moreexchange/web lint:fix",
      "prettier --write"
    ],
    "apps/api/**/*.ts": [
      "pnpm --filter @moreexchange/api lint:fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "plugins": []
  }
}
