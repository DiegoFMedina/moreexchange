# .env — Raíz del monorepo (PM2 lee este con dotenv desde ecosystem.config.js)
# Ajustado para producción en problemasinformaticos.cloud
# En local: copia a .env.local y usa NEXT_PUBLIC_API_URL=http://localhost:3001/v1 y ALLOWED_ORIGINS=http://localhost:3000

# Base de datos — en el servidor usa la URL real de PostgreSQL (usuario, contraseña, host, nombre DB)
DATABASE_URL="postgresql://postgres:CAMBIAR_EN_SERVIDOR@localhost:5432/moreexchange_db"
REDIS_URL="redis://localhost:6379"

# JWT — en producción usa secretos fuertes y distintos
JWT_SECRET=dev_secret_change_in_production_abc123def456
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_xyz789
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Producción: dominio público (sin HTTPS por ahora)
NEXT_PUBLIC_API_URL=http://problemasinformaticos.cloud/v1
ALLOWED_ORIGINS=http://problemasinformaticos.cloud,http://www.problemasinformaticos.cloud

NODE_ENV=production

ADMIN_EMAIL=admin@moreexchange.cl
ADMIN_PASSWORD=Admin1234!

PORT_API=3001
PORT_WEB=3000
