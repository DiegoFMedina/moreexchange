# PATH: .env.example
# DESC: Variables de entorno de referencia — copiar a .env y completar con valores reales
# NUNCA commitear el archivo .env real al repositorio

# ── Base de datos ─────────────────────────────────────────────────────────────
# PostgreSQL local. Reemplazar con tus credenciales.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="postgresql://cambios_user:tu_password_aqui@localhost:5432/cambios_db"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# IMPORTANTE: JWT_SECRET y JWT_REFRESH_SECRET deben ser diferentes
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Stripe ────────────────────────────────────────────────────────────────────
# Obtener en https://dashboard.stripe.com/apikeys
# sk_live_... para producción | sk_test_... para desarrollo
STRIPE_SECRET_KEY=

# Obtener en https://dashboard.stripe.com/webhooks
# whsec_...
STRIPE_WEBHOOK_SECRET=

# Clave pública — puede exponerse al frontend sin riesgo
# pk_live_... para producción | pk_test_... para desarrollo
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── URLs ──────────────────────────────────────────────────────────────────────
# URL base de la API consumida por el frontend
# En desarrollo: http://localhost:3001/v1
# En producción: https://api.moreexchange.cl/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# Dominios permitidos en CORS, separados por coma
# En desarrollo:  http://localhost:3000
# En producción:  https://moreexchange.cl,https://www.moreexchange.cl
ALLOWED_ORIGINS=http://localhost:3000

# ── Entorno ───────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development

# ── Credenciales del admin inicial (usadas en prisma seed) ───────────────────
# Cambiar la contraseña después del primer seed en producción
ADMIN_EMAIL=admin@moreexchange.cl
ADMIN_PASSWORD=Admin1234!

# ── Puertos ───────────────────────────────────────────────────────────────────
PORT_API=3001
PORT_WEB=3000
